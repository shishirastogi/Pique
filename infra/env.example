# FocusWarmup API environment — the app auto-loads D:\pique-project\infra\.env
# (already created from this template). Paste keys there & restart the API.
# Everything has a working default; uncomment what you configure.

# --- database (slice default: sqlite file; content phase swaps to Postgres+pgvector)
# PIQUE_DATABASE_URL=sqlite:///./data/pique.db
# PIQUE_DATABASE_URL=postgresql+psycopg://pique:pique@localhost:5432/pique

# --- LLM (free tiers; comma-list = failover chain. Without a key the app uses
#     templates + heuristic parsing. RECOMMENDED for dev: add a Groq key —
#     Gemini's free daily quota is tiny and shared per-project.)
#   gemini → https://aistudio.google.com/apikey     (limit ~20 req/day free-trial spent fast)
#   groq   → https://console.groq.com/keys          (best free dev quota; put FIRST in chain)
# PIQUE_LLM_PROVIDER=groq,gemini        # failover order
# PIQUE_LLM_API_KEY=your-key-here       # or set per-provider keys below
# PIQUE_GEMINI_API_KEY=
# PIQUE_GROQ_API_KEY=
# PIQUE_LLM_MODEL=gemini-flash-latest   # default already targets the live alias; override to pin
# PIQUE_LLM_TIMEOUT_S=15

# --- semantic ranking (needs embedding quota on the gemini key; off by default
#     because a spent key makes every ingest slow-fail. Lexical ranking stays.)
# PIQUE_EMBEDDINGS_ENABLED=false
# PIQUE_EMBEDDING_MODEL=gemini-embedding-001

# --- media enrichment (free keys; absent → owned SVG card visuals are used instead)
#   GIPHY  → https://developers.giphy.com/  (Create App → API Key)  real reaction GIFs
# PIQUE_GIPHY_API_KEY=your-giphy-key
#   Imgflip → https://imgflip.com/signup (free account)             real captioned memes
# PIQUE_IMGFLIP_USERNAME=your-user
# PIQUE_IMGFLIP_PASSWORD=your-pass

# --- external content providers (all optional flags default sensible)
# PIQUE_WIKIPEDIA_ENABLED=true          # free, no key — real fact cards
# PIQUE_WIKIMEDIA_ENABLED=true          # no key; contact-info UA required (set below)
# PIQUE_OPENVERSE_ENABLED=true          # anonymous OK at low limits
# PIQUE_GUTENBERG_ENABLED=false         # unreliable in some networks
# PIQUE_PROVIDER_USER_AGENT="FocusWarmup/0.1-slice (https://github.com/focuswarmup/focuswarmup; dev@focuswarmup.example)"

# --- core
# PIQUE_SECRET_KEY=change-me-in-any-real-deployment
# PIQUE_LOCK_DEFAULT_MINUTES=120
